# -------------------------------------------------------------------------------
# CogniCompanion — Frontend Environment Variables
# -------------------------------------------------------------------------------
# Copy this file to .env and adjust for your setup.
# The .env file is gitignored — never commit it.
# -------------------------------------------------------------------------------

# -- API -----------------------------------------------------------------------
# In production (served via nginx reverse-proxy) this stays as /api/v1 so the
# browser hits the same origin and nginx forwards the request to the backend.
# For local Vite dev server set to: http://localhost:8000/api/v1
VITE_API_URL=/api/v1
