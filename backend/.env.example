# ═══════════════════════════════════════════════════════════════════════════════
# CogniCompanion — Environment Variables
# ───────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────────
APP_NAME=CogniCompanion
APP_ENV=development          # development | production
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────────
# Async URL used by SQLAlchemy with asyncpg driver.
DATABASE_URL=postgresql+asyncpg://cogni_user:cogni_pass@localhost:5432/cognicompanion

# Sync URL used by Alembic migrations (psycopg2 / asyncpg sync mode).
SYNC_DATABASE_URL=postgresql+psycopg2://cogni_user:cogni_pass@localhost:5432/cognicompanion

# ── JWT Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google AI (Gemini) ────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here

# Model names — configurable so you can upgrade without code changes
LLM_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=models/text-embedding-004
TTS_LANGUAGE_CODE=en-IN          # Indian English TTS
STT_LANGUAGE_CODE=en-IN          # Indian English STT

# ── Storage ──────────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local           # local | s3 (future)
LOCAL_STORAGE_PATH=./uploads     # Only used when STORAGE_PROVIDER=local

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── API ──────────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── Demo / Seed Account (SIH Demo only) ──────────────────────────────────────────
# Used by seed_rich_dataset.py and the Flutter patient app one-tap demo login.
# Change or remove these before any real production deployment.
DEMO_PATIENT_EMAIL=patient@cognicompanion.demo
DEMO_PATIENT_PASSWORD=change-this-before-production
